[gd_scene format=3]

[node name="CombatStatusPanel" type="PanelContainer"]
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Heading" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2

[node name="Round" type="Label" parent="Margin/Content/Heading"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.776, 0.647, 0.416, 1)
text = "ROUND 01"

[node name="Turn" type="Label" parent="Margin/Content/Heading"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.91, 0.89, 0.84, 1)
text = "PLAYER TURN"

[node name="EnemyList" type="HBoxContainer" parent="Margin/Content"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="IntentCard" type="PanelContainer" parent="Margin/Content"]
visible = false
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Margin/Content/IntentCard"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="Content" type="VBoxContainer" parent="Margin/Content/IntentCard/Margin"]
layout_mode = 2
theme_override_constants/separation = 3

[node name="Heading" type="Label" parent="Margin/Content/IntentCard/Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.86, 0.69, 0.43, 1)
text = "Goblin A · Possible Heavy Strike"

[node name="Description" type="Label" parent="Margin/Content/IntentCard/Margin/Content"]
layout_mode = 2
autowrap_mode = 3
theme_override_font_sizes/font_size = 12
text = "The goblin appears to be preparing an attack."

[node name="Confidence" type="Label" parent="Margin/Content/IntentCard/Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 9
theme_override_colors/font_color = Color(0.608, 0.639, 0.678, 1)
text = "PREDICTED"
