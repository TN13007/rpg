[gd_scene format=3]

[node name="CombatActionPanel" type="PanelContainer"]
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 10

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 7

[node name="Title" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 10
theme_override_colors/font_color = Color(0.776, 0.647, 0.416, 1)
text = "YOUR ACTION"

[node name="ActionGrid" type="GridContainer" parent="Margin/Content"]
layout_mode = 2
size_flags_horizontal = 3
columns = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
