[gd_scene format=3]

[node name="ActionList" type="PanelContainer"]
custom_minimum_size = Vector2(245, 0)
size_flags_horizontal = 3
size_flags_vertical = 3
size_flags_stretch_ratio = 0.30

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 6

[node name="Heading" type="Label" parent="Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 10
theme_override_colors/font_color = Color(0.776, 0.647, 0.416, 1)
text = "SKILLS"

[node name="SkillScroll" type="ScrollContainer" parent="Margin/Content"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 1
vertical_scroll_mode = 2

[node name="SkillList" type="VBoxContainer" parent="Margin/Content/SkillScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="PartyTargets" type="VBoxContainer" parent="Margin/Content"]
visible = false
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 6
